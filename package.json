{
  "name": "backuphub-site",
  "version": "1.2.1",
  "private": true,
  "description": "Landing page estática do BackupHub",
  "type": "module",
  "scripts": {
    "assets": "node tools/process-assets.mjs",
    "versions": "node tools/generate-versions.mjs",
    "versions:check": "node tools/generate-versions.mjs --check",
    "check": "npm run versions:check && html-validate \"public/**/*.html\" && node tools/check-site.mjs",
    "dev": "node tools/dev-server.mjs"
  },
  "devDependencies": {
    "html-validate": "11.6.0",
    "sharp": "0.35.3"
  }
}
